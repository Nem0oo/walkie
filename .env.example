# À copier vers /home/nem0oo/homelab-services/walkie/.env
# Pas de secrets ici : pas d'authentification forte en v1, le "secret" est le code de
# canal lui-même (comme un lien de partage classique).

PORT=3000
DATA_DIR=/data
MAX_UPLOAD_BYTES=8388608
CHANNEL_CODE_LENGTH=10
# Origines navigateur autorisées à appeler l'API (CORS), séparées par des virgules.
# Vide = même origine uniquement. Ex : https://autre-site.exemple
ALLOWED_ORIGINS=
PUBLIC_BASE_URL=https://xxx.xxx.xx
VIRTUAL_HOST=xxx.xxx.xx
VIRTUAL_PORT=3000
LETSENCRYPT_HOST=xxx.xxx.xx
