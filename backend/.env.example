PORT=3000
DATA_DIR=./data-dev
MAX_UPLOAD_BYTES=8388608
CHANNEL_CODE_LENGTH=10
PUBLIC_BASE_URL=http://localhost:3000
# Origines navigateur autorisées à appeler l API (CORS), séparées par des virgules. Vide = même origine uniquement.
ALLOWED_ORIGINS=
# Durée maximale d'un message (secondes) appliquée par le serveur.
MAX_DURATION_SECONDS=125
# Nombre de reverse proxies devant l app (nginx-proxy = 1, 0 si exposée directement sur Internet).
TRUST_PROXY=1
