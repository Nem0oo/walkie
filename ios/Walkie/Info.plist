<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reference only. Xcode manages the real Info.plist (or the equivalent
  INFOPLIST_KEY_* build settings) once you check "Background Modes → Audio,
  AirPlay, and Picture in Picture" in Signing & Capabilities — don't hand-edit
  the key below, let Xcode keep it in sync with the capability checkbox.
  No NSMicrophoneUsageDescription is needed: this app never records audio
  itself, only contacts do, via the web page, in their own browser.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>
